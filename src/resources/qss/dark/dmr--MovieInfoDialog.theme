/* GXDE movie palette (max 3 theme colors):
 * 1. background  white
 * 2. text        black / #606060
 * 3. accent      #2ca7f8
 * All text in this dialog uses one size: 12px
 */
dmr--MovieInfoDialog {
    qproperty-backgroundColor: white;
    qproperty-borderColor: rgba(0, 0, 0, 0.2);
}

#MovieInfoTitle {
    qproperty-alignment: AlignCenter;
    color: black;
    font-size: 12px;
}

#MovieInfoSplit {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
}

#MovieInfoKey {
    border: 1px solid transparent;
    qproperty-alignment: AlignRight;
    font-size: 12px;
    color: #606060;
}

#MovieInfoValue {
    border: 1px solid transparent;
    qproperty-alignment: AlignLeft;
    font-size: 12px;
    color: #000000;
}
